rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'lastLoginAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 128))
        && (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 128));
    }

    // Validation for StudyFile
    function isValidStudyFile(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'type', 'extractedContent'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'type', 'size', 'extractedContent', 'uploadedAt', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 256
        && data.type is string && data.type.size() <= 64
        && (!('size' in data) || data.size is number)
        && data.extractedContent is string && data.extractedContent.size() <= 500000;
    }

    // Validation for QuizAttempt
    function isValidQuizAttempt(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'subject', 'format', 'score', 'totalQuestions', 'totalDurationSeconds', 'questionLogs'])
        && data.keys().hasOnly(['id', 'userId', 'subject', 'format', 'score', 'totalQuestions', 'totalDurationSeconds', 'questionLogs', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.subject is string && data.subject.size() <= 64
        && data.format is string && data.format.size() <= 64
        && data.score is number
        && data.totalQuestions is number
        && data.totalDurationSeconds is number
        && data.questionLogs is string && data.questionLogs.size() <= 500000;
    }

    // Validation for SpacedSchedule
    function isValidSpacedSchedule(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'topicName', 'subject', 'attentionLevel', 'lastScore', 'reviewIntervalDays', 'nextReviewDate'])
        && data.keys().hasOnly(['id', 'userId', 'topicName', 'subject', 'attentionLevel', 'lastScore', 'reviewIntervalDays', 'nextReviewDate', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.topicName is string && data.topicName.size() <= 128
        && data.subject is string && data.subject.size() <= 64
        && (data.attentionLevel == 'High Attention Needed' || data.attentionLevel == 'Some Attention Needed' || data.attentionLevel == 'Low Attention Needed')
        && data.lastScore is number
        && data.reviewIntervalDays is number
        && data.nextReviewDate is string && data.nextReviewDate.size() <= 64;
    }

    // Validation for FeynmanAnalysis
    function isValidFeynmanAnalysis(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'conceptName', 'userExplanation', 'clarityScore', 'grade', 'analysisJson'])
        && data.keys().hasOnly(['id', 'userId', 'conceptName', 'userExplanation', 'clarityScore', 'grade', 'analysisJson', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.conceptName is string && data.conceptName.size() <= 128
        && data.userExplanation is string && data.userExplanation.size() <= 10000
        && data.clarityScore is number
        && data.grade is string && data.grade.size() <= 32
        && data.analysisJson is string && data.analysisJson.size() <= 100000;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket user listing forbidden
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
                    && (!('uid' in existing()) || incoming().uid == existing().uid);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Uploaded Study Files & Notes
      match /files/{fileId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(fileId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(fileId) && isValidStudyFile(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(fileId) && isValidStudyFile(incoming(), userId)
                      && (!('userId' in existing()) || incoming().userId == existing().userId)
                      && (!('id' in existing()) || incoming().id == existing().id);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(fileId);
      }

      // Quiz Attempts & Time Spent Records
      match /quizAttempts/{attemptId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(attemptId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(attemptId) && isValidQuizAttempt(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(attemptId) && isValidQuizAttempt(incoming(), userId)
                      && (!('userId' in existing()) || incoming().userId == existing().userId)
                      && (!('id' in existing()) || incoming().id == existing().id);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(attemptId);
      }

      // Spaced Repetition Schedules
      match /spacedSchedules/{topicId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(topicId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(topicId) && isValidSpacedSchedule(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(topicId) && isValidSpacedSchedule(incoming(), userId)
                      && (!('userId' in existing()) || incoming().userId == existing().userId)
                      && (!('id' in existing()) || incoming().id == existing().id);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(topicId);
      }

      // Feynman Technique Analyses
      match /feynmanAnalyses/{analysisId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(analysisId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(analysisId) && isValidFeynmanAnalysis(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(analysisId) && isValidFeynmanAnalysis(incoming(), userId)
                      && (!('userId' in existing()) || incoming().userId == existing().userId)
                      && (!('id' in existing()) || incoming().id == existing().id);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(analysisId);
      }
    }
  }
}
